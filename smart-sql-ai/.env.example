# 智能SQL - 环境变量配置
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ==========================================
# LLM 配置（OpenAI 兼容接口）
# ==========================================
# DeepSeek API: https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# MySQL root 密码，仅用于知识库同步脚本；请填写本机实际密码
MYSQL_PASSWORD=your-mysql-password

# ==========================================
# Embedding 模型（本地运行，无需 API）
# ==========================================
# 首次运行自动下载 paraphrase-multilingual-MiniLM-L12-v2 (~470MB)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ==========================================
# ChromaDB 向量存储路径
# ==========================================
CHROMA_PERSIST_DIR=./chroma_db

# ==========================================
# 服务配置
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Java 中间层地址
JAVA_SERVER_URL=http://localhost:8080

# ==========================================
# 安全配置
# ==========================================
# 内部调用令牌：Java 中间层调用 /ai/knowledge/sync 时通过请求头 X-Internal-Token 携带
# （该接口可覆盖甚至清空整个向量库，故必须鉴权）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 留空 = 同步接口一律拒绝（fail-closed），不会退化成"无防护"
# ⚠️ Java 侧读同名环境变量，start-all.bat 会自动从本文件读取并注入，无需重复配置
INTERNAL_API_TOKEN=please-generate-a-random-token

# CORS 允许的前端来源，逗号分隔（禁止使用 *）
ALLOWED_ORIGINS=http://localhost:5173
